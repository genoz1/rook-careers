{
  "name": "rook-careers",
  "version": "0.2.0",
  "description": "ROOK Careers \u2014 UI prototype plus Phase 1 backend scaffold (Supabase, Stripe, ATS ingestion adapters).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "ingest": "node backend/ingest.js",
    "ingest-adzuna": "node backend/ingestAdzuna.js",
    "discover-employers": "node backend/discoverEmployers.js",
    "backfill-ai-analysis": "node backend/scripts/backfillMissingAiAnalysis.js",
    "send-digest": "node backend/sendDigest.js",
    "precompute-scores": "node backend/precomputeScores.js",
    "archive-old-jobs": "node backend/archiveOldJobs.js",
    "test-trial-flow": "node backend/testTrialFlow.js",
    "test-job-eligibility": "node backend/testJobEligibility.js",
    "test-custom-html": "node --test backend/testCustomHtml.js",
    "test-custom-html-candidates": "node --test backend/testCustomHtmlNewCandidates.js",
    "test-successfactors": "node --test backend/testSuccessFactors.js",
    "test-workable": "node --test backend/testWorkable.js",
    "test-pinpoint": "node --test backend/testPinpoint.js",
    "test-clinchtalent": "node --test backend/testClinchTalent.js",
    "test-applicantpro": "node --test backend/testApplicantPro.js",
    "validate-sources": "node backend/validateSources.js",
    "test-source-validator": "node --test backend/testSourceValidator.js",
    "test-ingest-capacity": "node --test backend/testIngestCapacity.js",
    "test-masked-presentation": "node backend/testMaskedPresentation.js",
    "test-all": "npm run test-masked-presentation && npm run test-custom-html && npm run test-custom-html-candidates && npm run test-successfactors && npm run test-workable && npm run test-pinpoint && npm run test-clinchtalent && npm run test-applicantpro && npm run test-source-validator && npm run test-ingest-capacity && npm run test-job-eligibility && npm run test-trial-flow && npm run test-ui-copy && npm run test-v6-email-code && npm run test-daily-digest-location",
    "test-daily-digest-location": "node backend/testDailyDigestLocation.js",
    "test-v6-email-code": "node backend/testV6EmailCode.js",
    "test-resume-achievements": "node backend/testResumeAchievements.js",
    "test-social-automation": "node backend/testSocialAutomation.js",
    "social:discover-channels": "node backend/socialPublishWorker.js discover",
    "social:validate-only": "node backend/socialPublishWorker.js validate",
    "social:live-test": "node backend/socialPublishWorker.js live-test --confirm-live",
    "test-social-publish-worker": "node backend/testSocialPublishWorker.js",
    "test-social-scheduler": "node backend/testSocialScheduler.js",
    "social:scheduled-dispatch": "node backend/socialPublishWorker.js scheduled-dispatch",
    "social:scheduler-status": "node backend/socialPublishWorker.js scheduler-status",
    "test-ui-copy": "node backend/testUiCopy.js",
    "ad-manager": "node backend/admanager/manager.js",
    "test-ad-manager": "node backend/admanager/test.js",
    "test-industry-location": "node backend/testIndustryLocation.js && node backend/testV7Location.js",
    "test-job-search": "node --test backend/testJobSearch.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cheerio": "1.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "i18n-iso-countries": "^7.14.0",
    "mammoth": "^1.8.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.35.4",
    "stripe": "^16.8.0",
    "zipcodes": "^8.0.0"
  },
  "devDependencies": {
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "topojson-client": "^3.1.0",
    "us-atlas": "^3.0.1"
  }
}
