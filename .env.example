# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already in .gitignore.

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Stripe (Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID_MONTHLY=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Free trial (2026-09, launched at 7 days, since changed to 3). Set to 0 or remove entirely to disable the
# trial and go back to charging $29 immediately at signup — that's the
# whole switch, no code change needed either way. Every piece of
# customer-facing copy (pricing page, announcement bar, CTAs) reads
# this value dynamically — nothing else needs to change if this number
# changes again later.
TRIAL_PERIOD_DAYS=3

# --- AI / embeddings (pick one provider) ---
ANTHROPIC_API_KEY=sk-ant-...
# or: OPENAI_API_KEY=sk-...

# --- App ---
PUBLIC_APP_URL=http://localhost:8080
PORT=8080

# --- Social posting automation (2026-09, foundations only — no Buffer
# publishing worker yet) ---
# Both secrets below: generate with `openssl rand -hex 32`. Each must
# be a DIFFERENT value from any Buffer API key you configure later —
# they authenticate different systems, and reusing one secret for both
# means a single leak compromises both. Set the real values directly
# in your hosting platform's environment settings; never commit,
# print, or share them.
SOCIAL_AUTOMATION_TOKEN=
SOCIAL_SPACING_HMAC_SECRET=
# Optional tuning (all have safe defaults if omitted):
SOCIAL_FRESHNESS_WINDOW_DAYS=3
SOCIAL_EMPLOYER_SPACING_DAYS=14
SOCIAL_CATEGORY_VARIATION_LOOKBACK=4
# Comma-separated branded/product/program names to redact, IN ADDITION
# to every employer name already in the employers table (fetched live,
# not something to duplicate here). No authoritative source exists for
# these anywhere in the app — populate and maintain manually as real
# branded terms are identified.
SOCIAL_BRANDED_TERMS=

# --- Buffer publishing worker (2026-09) ---
# Required for backend/socialPublishWorker.js's discover/validate/
# live-test commands. BUFFER_ACCESS_TOKEN must already be a
# server-to-server Buffer personal access token with permission to
# read profiles and create updates. Set the real value directly in
# your hosting platform's environment settings; never commit, print,
# or share it. Get one at https://buffer.com (Settings -> Apps) or
# generate a personal access token from your Buffer account.
BUFFER_ACCESS_TOKEN=
# The exact Buffer channel (profile) IDs for ROOK's two approved
# business pages — find these by running `npm run
# social:discover-channels` after BUFFER_ACCESS_TOKEN is set, which
# lists every connected channel's id/service/name without ever
# displaying the token itself. Do not point either of these at a
# personal profile — the worker validates and refuses to run if you do.
BUFFER_ROOK_LINKEDIN_CHANNEL_ID=
BUFFER_ROOK_FACEBOOK_CHANNEL_ID=

# --- Recurring twice-daily social automation (2026-09) ---
# Global emergency pause: when this is anything other than the exact
# string "true" (including unset/missing), the recurring scheduled
# job sends nothing at all - checked before anything else runs.
# Set to "true" only once you've reviewed the scheduler status
# command's output and are ready for it to actually post.
SOCIAL_AUTOMATION_ENABLED=false
